# ==========================================================
# Tracks AI Platform — Environment Configuration
# ==========================================================
# Copy this file to .env and fill in your values.
# Lines starting with # are comments.
# ==========================================================


# ──────────────────────────────────────────────────────────
# CORE APPLICATION
# ──────────────────────────────────────────────────────────
PROJECT_NAME="SkillSync API"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://localhost:8000"]'

# ──────────────────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────────────────
JWT_SECRET_KEY="supersecretkeychangeinproduction"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ──────────────────────────────────────────────────────────
# DATABASE — MongoDB
# ──────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=skillsync

# ──────────────────────────────────────────────────────────
# LLM PROVIDER (openai | azure)
# ──────────────────────────────────────────────────────────
LLM_PROVIDER=openai

# OpenAI Direct
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# Google Gemini (used for topic content generation)
GOOGLE_API_KEY=

# Groq (free-tier fallback for topic content)
GROQ_API_KEY=

# ──────────────────────────────────────────────────────────
# EMBEDDINGS
# ──────────────────────────────────────────────────────────
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL_NAME=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# ──────────────────────────────────────────────────────────
# RAG — ChromaDB Vector Store
# ──────────────────────────────────────────────────────────
CHROMADB_PERSIST_DIRECTORY=./chromadb_store

# ──────────────────────────────────────────────────────────
# YOUTUBE AGENT
# ──────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ──────────────────────────────────────────────────────────
# PDF AGENT
# ──────────────────────────────────────────────────────────
# (No extra keys needed — uses the configured LLM + ChromaDB)

# ──────────────────────────────────────────────────────────
# FASTER-WHISPER TRANSCRIPTION
# ──────────────────────────────────────────────────────────
WHISPER_ENABLED=true
WHISPER_MODEL_SIZE=base

# ──────────────────────────────────────────────────────────
# SEARCH API
# ──────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ──────────────────────────────────────────────────────────
# LANGSMITH OBSERVABILITY (Optional)
# ──────────────────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tracks-ai-mentor

# ──────────────────────────────────────────────────────────
# DEBUG & RATE LIMITS
# ──────────────────────────────────────────────────────────
MENTOR_DEBUG=false
MENTOR_DAILY_CHAT_LIMIT=100
MENTOR_MAX_PDF_SIZE_MB=10
MENTOR_MAX_YOUTUBE_DURATION_MINS=30
